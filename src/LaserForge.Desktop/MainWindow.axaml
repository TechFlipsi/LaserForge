<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LaserForge.Desktop.Controls"
        x:Class="LaserForge.Desktop.MainWindow"
        Title="Unbenannt - GRBL - LaserForge"
        RequestedThemeVariant="Dark"
        Width="1600" Height="900" MinWidth="1150" MinHeight="680"
        Background="#222222">

  <!-- M5-a/M5-b: Aufbau nach docs/design-ziel-bild.md (Farb-/Regions-Tabelle der Bibel).
       Eigene Icons, eigener deutscher Wortlaut, keine Fremd-Assets.
       M5-b: Ebenen-Liste, Canvas-Werkzeuge, Datei-IO, Preview-Tab, Konsole-Sperre, Maus-mm. -->

  <Window.Styles>
    <Style Selector="Button.leiste">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="30"/>
    </Style>
    <Style Selector="Button.werkzeug">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
    </Style>
    <Style Selector="Button.werkzeug.aktiv">
      <Setter Property="Background" Value="#4B4B4B"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="#FF9900"/>
    </Style>
    <Style Selector="Button.gross">
      <Setter Property="Background" Value="#3E3E3E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#585858"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#E0E0E0"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="Button.klein">
      <Setter Property="Background" Value="#3A3A3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#505050"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#D8D8D8"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="#2E2E2E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="#B8B8B8"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="0,2,2,2"/>
    </Style>
    <Style Selector="Button.tab.aktiv">
      <Setter Property="Background" Value="#4A4A4A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="ToggleSwitch.knipf">
      <Setter Property="MinWidth" Value="30"/>
      <Setter Property="FontSize" Value="9"/>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- ============ Statusleiste (unten, 5 Segmente) ============ -->
    <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Height="26" BorderBrush="#141414" BorderThickness="0,1,0,0">
      <Grid Margin="10,0" ColumnDefinitions="2*,1*,1.2*,1*,0.6*">
        <TextBlock x:Name="StatusMaus" Grid.Column="0" Text="X 0,000 mm · Y 0,000 mm" FontSize="11" Foreground="#C8C8C8" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusWerkzeug" Grid.Column="1" Text="Werkzeug: Auswahl" FontSize="11" Foreground="#C8C8C8" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusAuswahl" Grid.Column="2" Text="Auswahl: 0 Objekte" FontSize="11" Foreground="#C8C8C8" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusMeldung" Grid.Column="3" Text="Fertig" FontSize="11" Foreground="#C8C8C8" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" Text="mm" FontSize="11" Foreground="#C8C8C8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
    </Border>

    <!-- ============ Layer-Leiste (unten, Chips 00..30 + T1/T2, Palette aus Bibel) ============ -->
    <Border DockPanel.Dock="Bottom" Background="#2B2B2B" Height="32" BorderBrush="#454545" BorderThickness="0,1,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Layerleiste" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"/>
      </ScrollViewer>
    </Border>

    <!-- ============ Menueleiste (eigene deutsche Bezeichnungen, M5-b: echte Einträge) ============ -->
    <Menu DockPanel.Dock="Top" Height="26" Background="#1C1C1C" FontSize="12">
      <MenuItem Header="Datei">
        <MenuItem Header="Neu" Click="OnNeu"/>
        <MenuItem Header="Öffnen …" Click="OnOeffnen"/>
        <MenuItem Header="Speichern" Click="OnSpeichern"/>
        <Separator/>
        <MenuItem Header="Beenden" Click="OnBeenden"/>
      </MenuItem>
      <MenuItem Header="Bearbeiten">
        <MenuItem x:Name="MenuUndo" Header="Rückgängig" Click="OnUndo"/>
        <MenuItem x:Name="MenuRedo" Header="Wiederholen" Click="OnRedo"/>
        <MenuItem x:Name="MenuLoeschen" Header="Auswahl löschen" Click="OnAuswahlLoeschen"/>
      </MenuItem>
      <MenuItem Header="Anordnen"/>
      <MenuItem Header="Laserwerkzeuge"/>
      <MenuItem Header="Web-Werkzeuge"/>
      <MenuItem Header="Fenster"/>
      <MenuItem Header="Sprache"/>
      <MenuItem Header="Hilfe"/>
    </Menu>

    <!-- ============ Hauptleiste R1: eigne Werkzeug-Icons (einfache Geometrie) ============ -->
    <Border DockPanel.Dock="Top" Background="#262626" Height="40" Padding="6,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
          <Button Classes="leiste" ToolTip.Tip="Neues Projekt (Strg+N)" Click="OnNeu">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M2.2 1 L8.5 1 L11.8 4.3 L11.8 13 L2.2 13 Z"/>
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M8.5 1 L8.5 4.3 L11.8 4.3"/>
            </Panel>
          </Button>
          <Button Classes="leiste" ToolTip.Tip="Projekt öffnen (Strg+O)" Click="OnOeffnen">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M1.5 3.2 H5.4 L7 4.8 H12.5 V12.2 H1.5 Z"/>
            </Panel>
          </Button>
          <Button Classes="leiste" ToolTip.Tip="Import (SVG/DXF/Bild)">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M2 8.5 H12 V13 H2 Z"/>
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M7 1.5 V6.5 M4.6 4.2 L7 6.6 L9.4 4.2"/>
            </Panel>
          </Button>
          <Button Classes="leiste" ToolTip.Tip="Projekt speichern (Strg+S)" Click="OnSpeichern">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M1.8 1.8 H12.2 V12.2 H1.8 Z M4.6 1.8 V5.4 H9.8 V1.8 M4.6 9.6 H9.8 V12.2"/>
            </Panel>
          </Button>
          <Button Classes="leiste" ToolTip.Tip="Rückgängig (Strg+Z)" Click="OnUndo">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.3" Data="M11 9.6 C11 5.6 7 4.4 4.4 6 M6.2 3.4 L3.6 6.2 L7.2 7"/>
            </Panel>
          </Button>
          <Button Classes="leiste" ToolTip.Tip="Wiederholen (Strg+Y)" Click="OnRedo">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.3" Data="M3 9.6 C3 5.6 7 4.4 9.6 6 M7.8 3.4 L10.4 6.2 L6.8 7"/>
            </Panel>
          </Button>
          <Button Classes="leiste" ToolTip.Tip="Kamera">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M1.8 4.6 H12.2 V12.2 H1.8 Z M4.8 4.6 L5.8 2.6 H8.6 L9.6 4.6"/>
              <Ellipse Width="4.6" Height="4.6" Stroke="#D8D8D8" StrokeThickness="1.1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0"/>
            </Panel>
          </Button>
          <Button Classes="leiste" ToolTip.Tip="Gruppieren (Platzhalter M5-b)">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M1.8 1.8 H8.4 V8.4 H1.8 Z"/>
              <Path Stroke="#9A9A9A" StrokeThickness="1.2" Data="M5.4 5.8 H12 V12.4 H5.4 Z"/>
            </Panel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Einheiten" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center"/>
          <ComboBox Width="56" Height="24" FontSize="11" SelectedIndex="0">
            <ComboBoxItem Content="mm"/>
            <ComboBoxItem Content="in"/>
          </ComboBox>
          <!-- 2 kleine 3×3-Punkte-Grids (Job-Ausgangsposition, Bibel R1 rechts) -->
          <local:PunkteRaster9 Width="42" Height="24"/>
          <local:PunkteRaster9 Width="42" Height="24"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Eigenschaften-Leiste R2 (M5-b: live gebunden an die Auswahl) ============ -->
    <Border DockPanel.Dock="Top" Background="#262626" Height="38" Padding="6,3" BorderBrush="#1B1B1B" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
          <TextBlock Text="XPos" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center" Margin="4,0,2,0"/>
          <TextBox x:Name="FeldXPos" Text="" Width="56" Height="22" FontSize="11" Background="#313131" BorderBrush="#4A4A4A" Foreground="#E8E8E8" TextAlignment="Right"/>
          <TextBlock Text="YPos" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center" Margin="6,0,2,0"/>
          <TextBox x:Name="FeldYPos" Text="" Width="56" Height="22" FontSize="11" Background="#313131" BorderBrush="#4A4A4A" Foreground="#E8E8E8" TextAlignment="Right"/>
          <TextBlock Text="Breite" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center" Margin="8,0,2,0"/>
          <TextBox x:Name="FeldBreite" Text="" Width="64" Height="22" FontSize="11" Background="#313131" BorderBrush="#4A4A4A" Foreground="#E8E8E8" TextAlignment="Right"/>
          <TextBlock Text="Höhe" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center" Margin="6,0,2,0"/>
          <TextBox x:Name="FeldHoehe" Text="" Width="64" Height="22" FontSize="11" Background="#313131" BorderBrush="#4A4A4A" Foreground="#E8E8E8" TextAlignment="Right"/>
          <TextBlock Text="Drehen" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center" Margin="10,0,2,0"/>
          <TextBox x:Name="FeldDrehen" Text="0,00" Width="48" Height="22" FontSize="11" Background="#313131" BorderBrush="#4A4A4A" Foreground="#E8E8E8" TextAlignment="Right"/>
          <TextBlock Text="°" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center" Margin="2,0,6,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="X ausrichten" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center"/>
          <ComboBox Width="86" Height="22" FontSize="11" SelectedIndex="1" Background="#313131" BorderBrush="#4A4A4A">
            <ComboBoxItem Content="Links"/><ComboBoxItem Content="Mitte"/><ComboBoxItem Content="Rechts"/>
          </ComboBox>
          <TextBlock Text="Y ausrichten" FontSize="11" Foreground="#A8A8A8" VerticalAlignment="Center" Margin="6,0,0,0"/>
          <ComboBox Width="86" Height="22" FontSize="11" SelectedIndex="1" Background="#313131" BorderBrush="#4A4A4A">
            <ComboBoxItem Content="Oben"/><ComboBoxItem Content="Mitte"/><ComboBoxItem Content="Unten"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ Hauptbereich: Werkzeugspalte | Arbeitsfläche | Rechts-Panel ============ -->
    <Grid ColumnDefinitions="44,*,500" Background="#222222">

      <!-- Linke Werkzeugspalte: 13 eigene Icons; Auswahl AKTIV markiert -->
      <Border Grid.Column="0" Background="#252525" BorderBrush="#1B1B1B" BorderThickness="0,0,1,0">
        <StackPanel Margin="2,4" Orientation="Vertical">
          <Button x:Name="WzAuswahl" Classes="werkzeug aktiv" ToolTip.Tip="Auswahl (Verschieben)" Click="OnWerkzeugAuswahl">
            <Panel Width="14" Height="14">
              <Path Fill="#E8E8E8" Data="M2 1 L2 12.4 L4.9 9.9 L6.9 14 L8.9 13.1 L6.9 9 L10.6 8.6 Z"/>
            </Panel>
          </Button>
          <Button x:Name="WzKnoten" Classes="werkzeug" ToolTip.Tip="Knotenbearbeitung">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M3.6 10.6 L10.6 3.6"/>
              <Ellipse Width="4" Height="4" Stroke="#D8D8D8" StrokeThickness="1.1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"/>
              <Ellipse Width="4" Height="4" Stroke="#D8D8D8" StrokeThickness="1.1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,1,0,0"/>
            </Panel>
          </Button>
          <Button x:Name="WzHand" Classes="werkzeug" ToolTip.Tip="Hand (Verschieben der Fläche)">
            <Panel Width="14" Height="14">
              <Path Fill="#D8D8D8" Data="M2.2 6.6 H12 V12.4 H2.2 Z M3.4 3 H4.6 V6.6 H3.4 Z M5.8 2.2 H7 V6.6 H5.8 Z M8 2.8 H9.2 V6.6 H8 Z M10 2 H11.2 V6.6 H10 Z"/>
            </Panel>
          </Button>
          <Button x:Name="WzRechteck" Classes="werkzeug" ToolTip.Tip="Rechteck (F2)" Click="OnWerkzeugRechteck">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.3" Data="M1.8 2.6 H12.2 V11.4 H1.8 Z"/>
            </Panel>
          </Button>
          <Button x:Name="WzEllipse" Classes="werkzeug" ToolTip.Tip="Ellipse (F3)" Click="OnWerkzeugEllipse">
            <Panel Width="14" Height="14">
              <Ellipse Width="11" Height="9" Stroke="#D8D8D8" StrokeThickness="1.3"/>
            </Panel>
          </Button>
          <Button x:Name="WzPolygon" Classes="werkzeug" ToolTip.Tip="Polygon (F4)">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.3" Data="M7 1.6 L12 5.2 L10.1 11 L3.9 11 L2 5.2 Z"/>
            </Panel>
          </Button>
          <Button x:Name="WzLinie" Classes="werkzeug" ToolTip.Tip="Linie (F5)" Click="OnWerkzeugLinie">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.3" Data="M2.2 11.6 L11.8 2.4"/>
            </Panel>
          </Button>
          <Button x:Name="WzText" Classes="werkzeug" ToolTip.Tip="Text (F6)">
            <Panel Width="14" Height="14">
              <Panel>
                <Panel>
                  <TextBlock Text="T" FontSize="12" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                </Panel>
              </Panel>
            </Panel>
          </Button>
          <Button x:Name="WzBild" Classes="werkzeug" ToolTip.Tip="Bild einfügen">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M1.6 2 H12.4 V12 H1.6 Z"/>
              <Ellipse Width="2.8" Height="2.8" Stroke="#D8D8D8" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,4,0,0"/>
              <Path Stroke="#D8D8D8" StrokeThickness="1" Data="M3 11 L6 7.2 L7.8 9.4 M8 11 L9.8 8.6 L11.2 10.4"/>
            </Panel>
          </Button>
          <Button x:Name="WzMessen" Classes="werkzeug" ToolTip.Tip="Messen">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M1.6 4 H12.4 V10.4 H1.6 Z M4 4 V6.2 M6.4 4 V7.4 M8.8 4 V6.2 M11 4 V7.4"/>
            </Panel>
          </Button>
          <!-- Gruppentrennung: Erstellungen (oben) | Modifikatoren (unten) — Bibel-Zweispaltenlogik als Trennstrich -->
          <Border Height="1" Width="30" Background="#3F3F3F" HorizontalAlignment="Center" Margin="2,3"/>
          <Button x:Name="WzTrimmen" Classes="werkzeug" ToolTip.Tip="Trimmen">
            <Panel Width="14" Height="14">
              <Ellipse Width="3.4" Height="3.4" Stroke="#D8D8D8" StrokeThickness="1.1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0.6,0,0,0.6"/>
              <Ellipse Width="3.4" Height="3.4" Stroke="#D8D8D8" StrokeThickness="1.1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0.6,0.6,0,0"/>
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M2.6 11 L11.4 2.6 M11.4 11 L6.4 6.4"/>
            </Panel>
          </Button>
          <Button x:Name="WzLaschen" Classes="werkzeug" ToolTip.Tip="Laschen">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M3.4 1.8 H1.6 V12.2 H3.4 M10.6 1.8 H12.4 V12.2 H10.6 M5.4 4.4 H8.6 V9.6 H5.4 Z"/>
            </Panel>
          </Button>
          <Button x:Name="WzVertexten" Classes="werkzeug" ToolTip.Tip="Vertexten">
            <Panel Width="14" Height="14">
              <Path Stroke="#D8D8D8" StrokeThickness="1.2" Data="M2 11.6 L7 2.4 L12 11.6 Z"/>
              <Ellipse Width="3" Height="3" Stroke="#D8D8D8" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"/>
            </Panel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Arbeitsfläche: hell im dunklen Fenster (Bibel-Kern), M5-b: interaktiv -->
      <Border Grid.Column="1" Background="#FFFFFF" Margin="2,3,2,0" ClipToBounds="True">
        <local:Arbeitsflaeche x:Name="Flaeche" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      </Border>

      <!-- ============ Rechts-Panel ============ -->
      <Border Grid.Column="2" Background="#2B2B2B" Margin="2,3,2,0" Padding="8,4,8,6">
        <Grid RowDefinitions="24,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

          <!-- Kopfzeile 'Konsole' + rotes Band-Abschluss (Bibel) -->
          <Grid Grid.Row="0" Height="24" ColumnDefinitions="Auto,*">
            <TextBlock x:Name="TabTitel" Text="Konsole" FontSize="12" Foreground="#E8E8E8" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border Grid.Column="1" Height="16" VerticalAlignment="Center">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                  <GradientStop Color="#7A1B1B" Offset="0"/>
                  <GradientStop Color="#C0392B" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>

          <!-- Tab-Inhalte (7 Panels, Sichtbarkeit je aktiver Tab) -->
          <Grid Grid.Row="1" Margin="0,6,0,6">

            <!-- Tab Schnitte/Ebenen (M5-b: echte Liste aus dem Core-Projekt) -->
            <Grid x:Name="TabEbenen" IsVisible="False" RowDefinitions="Auto,Auto,*" Background="#1D1D1D">
              <TextBlock Grid.Row="0" Text="Schnitte/Ebenen (live aus dem Projekt)" FontSize="11" Foreground="#9A9A9A" Margin="8,6,8,2"/>
              <Grid Grid.Row="1" Margin="8,2,8,2" ColumnDefinitions="18,64,74,54,54,38,44">
                <TextBlock Text="" FontSize="9" Foreground="#8A8A8A"/>
                <TextBlock Grid.Column="1" Text="Name" FontSize="9" Foreground="#8A8A8A"/>
                <TextBlock Grid.Column="2" Text="Modus" FontSize="9" Foreground="#8A8A8A"/>
                <TextBlock Grid.Column="3" Text="Leistung %" FontSize="9" Foreground="#8A8A8A"/>
                <TextBlock Grid.Column="4" Text="Tempo mm/s" FontSize="9" Foreground="#8A8A8A"/>
                <TextBlock Grid.Column="5" Text="Aus" FontSize="9" Foreground="#8A8A8A"/>
                <TextBlock Grid.Column="6" Text="Sichtbar" FontSize="9" Foreground="#8A8A8A"/>
              </Grid>
              <ScrollViewer Grid.Row="2" Padding="0">
                <StackPanel x:Name="EbenenListe" Spacing="2" Margin="8,0,8,8"/>
              </ScrollViewer>
            </Grid>

            <!-- Tab Bewegen (Jog-Panel, Maschine stays fern — Projektregel) -->
            <Grid x:Name="TabBewegen" IsVisible="False" ColumnDefinitions="Auto,10,*" Background="#1D1D1D">
              <StackPanel Grid.Column="0" Width="150" Spacing="4" Margin="8,8,0,8">
                <Grid ColumnDefinitions="*,4,*">
                  <Button Grid.Column="0" Classes="klein" Content="Hoch 10"/>
                  <Button Grid.Column="2" Classes="klein" Content="Runter 10"/>
                </Grid>
                <Grid ColumnDefinitions="*,4,*">
                  <Button Grid.Column="0" Classes="klein" Content="Links 10"/>
                  <Button Grid.Column="2" Classes="klein" Content="Rechts 10"/>
                </Grid>
                <Grid ColumnDefinitions="*,4,*">
                  <Button Grid.Column="0" Classes="klein" Content="Z hoch"/>
                  <Button Grid.Column="2" Classes="klein" Content="Z runter"/>
                </Grid>
                <Button Classes="klein" Content="Zur Ausgangsposition gehen"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="Nur Anzeige — Steuerung erst in der M4-Live-Phase (Projektregel: Maschine fern)." FontSize="10" Foreground="#8A8A8A" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,8"/>
            </Grid>

            <!-- Tab Konsole (M5-b: Log-Fenster + gesperrte Eingabe ohne Verbindung) -->
            <Grid x:Name="TabKonsole" RowDefinitions="*,Auto,Auto" Background="#141414">
              <ScrollViewer Grid.Row="0" Margin="8,6,8,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="KonsoleLog" Orientation="Vertical"/>
              </ScrollViewer>
              <TextBlock x:Name="KonsoleHinhalt" Grid.Row="1" Text="Keine Verbindung — Gerät verbinden" FontSize="10" Foreground="#FF9C6B" Margin="8,4,8,0"/>
              <Grid Grid.Row="2" ColumnDefinitions="*,74" Margin="8,4,8,8">
                <TextBox x:Name="KonsoleEingabe" PlaceholderText="Befehl eingeben…" Height="24" FontSize="11" Background="#2E2E2E" BorderBrush="#4A4A4A" Foreground="#E8E8E8" IsEnabled="False"/>
                <Button x:Name="KonsoleSenden" Grid.Column="1" Classes="klein" Content="Senden" IsEnabled="False" VerticalAlignment="Center" Height="24" Margin="6,0,0,0"/>
              </Grid>
            </Grid>

            <!-- Tab Makros -->
            <Grid x:Name="TabMakros" IsVisible="False" Background="#1D1D1D">
              <StackPanel Margin="8,8" Spacing="6">
                <TextBlock Text="Makros" FontSize="12" Foreground="#E8E8E8"/>
                <TextBlock Text="Eigene wiederholbare Befehlsfolgen folgen in M5-b." FontSize="11" Foreground="#9A9A9A" TextWrapping="Wrap"/>
                <Button Classes="klein" Content="Makro aufzeichnen"/>
              </StackPanel>
            </Grid>

            <!-- Tab Kamera/Overlays -->
            <Grid x:Name="TabKamera" IsVisible="False" Background="#1D1D1D">
              <StackPanel Margin="8,8" Spacing="6">
                <TextBlock Text="Kamera / Overlays" FontSize="12" Foreground="#E8E8E8"/>
                <TextBlock Text="Kamerabild und Fadenkreuz folgen in M6." FontSize="11" Foreground="#9A9A9A" TextWrapping="Wrap"/>
                <Border Height="110" Background="#0F0F0F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="2">
                  <TextBlock Text="Kamera-Bild" FontSize="11" Foreground="#6E6E6E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </StackPanel>
            </Grid>

            <!-- Tab Seiten -->
            <Grid x:Name="TabSeiten" IsVisible="False" Background="#1D1D1D">
              <StackPanel Margin="8,8" Spacing="6">
                <TextBlock Text="Seiten" FontSize="12" Foreground="#E8E8E8"/>
                <TextBlock Text="Mehrseitige Projekte folgen in M6." FontSize="11" Foreground="#9A9A9A" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>

            <!-- Tab Vorschau (M5-b: echter Core-Simulator PreviewSimulator.Simuliere) -->
            <Grid x:Name="TabVorschau" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" Background="#1D1D1D">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,6">
                <Button x:Name="VorschauKnopf" Classes="klein" Content="Vorschau aktualisieren" Click="OnVorschauAktualisieren"/>
                <TextBlock x:Name="VorschauZeit" Text="Noch nicht simuliert" FontSize="11" Foreground="#D8D8D8" VerticalAlignment="Center"/>
              </StackPanel>
              <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="2" Margin="8,4,8,2" ClipToBounds="True">
                <Image x:Name="VorschauBild" Stretch="Uniform"/>
              </Border>
              <TextBlock Grid.Row="3" Text="Simulation: LaserForge.Core.Pipeline.PreviewSimulator — graue Pixelmatrix (1 px/mm) über Konturen + Scan-Raster." FontSize="9" Foreground="#8A8A8A" Margin="8,2,8,6" TextWrapping="Wrap"/>
            </Grid>
          </Grid>

          <!-- Tab-Leiste: zuerst die 6 Bibel-Tabs, dann Vorschau (M5-b-Zusatz) -->
          <StackPanel Grid.Row="2" Background="#232323" Orientation="Horizontal">
            <Button x:Name="TabKnopf0" Classes="tab" Content="Schnitte/Ebenen" Click="OnTabKnopf"/>
            <Button x:Name="TabKnopf1" Classes="tab" Content="Bewegen" Click="OnTabKnopf"/>
            <Button x:Name="TabKnopf2" Classes="tab" Content="Konsole" Click="OnTabKnopf"/>
            <Button x:Name="TabKnopf3" Classes="tab" Content="Makros" Click="OnTabKnopf"/>
            <Button x:Name="TabKnopf4" Classes="tab" Content="Kamera/Overlays" Click="OnTabKnopf"/>
            <Button x:Name="TabKnopf5" Classes="tab" Content="Seiten" Click="OnTabKnopf"/>
            <Button x:Name="TabKnopf6" Classes="tab" Content="Vorschau" Click="OnTabKnopf"/>
          </StackPanel>

          <!-- Laser-Band (rot) -->
          <Border Grid.Row="3" Height="20" Margin="0,4,0,2">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#7A1B1B" Offset="0"/>
                <GradientStop Color="#C0392B" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="Laser" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Border>

          <!-- Verbindungszustand -->
          <TextBlock Grid.Row="4" Text="Nicht verbunden" FontSize="11" Foreground="#D8D8D8" Margin="8,2,0,0"/>

          <!-- 3 große Buttons Pause / Stopp / Start -->
          <Grid Grid.Row="5" ColumnDefinitions="*,6,*,6,*" Margin="0,6,0,0">
            <Button Grid.Column="0" Classes="gross">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Panel Width="10" Height="12"><Path Fill="#E0E0E0" Data="M1 0 H4 V12 H1 Z M6 0 H9 V12 H6 Z"/></Panel>
                <TextBlock Text="Pause"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="gross">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Panel Width="12" Height="12"><Path Fill="#E0E0E0" Data="M1 1 H11 V11 H1 Z"/></Panel>
                <TextBlock Text="Stopp"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="4" Classes="gross">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Panel Width="12" Height="12"><Path Fill="#E0E0E0" Data="M2 1 L11 6 L2 11 Z"/></Panel>
                <TextBlock Text="Start"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- Rahmen-/G-code-Reihe -->
          <Grid Grid.Row="6" ColumnDefinitions="*,4,*,4,*,4,*" Margin="0,6,0,0">
            <Button Grid.Column="0" Classes="klein" Content="Rahmen"/>
            <Button Grid.Column="2" Classes="klein" Content="Rahmen (Auswahl)"/>
            <Button Grid.Column="4" Classes="klein" Content="G-code speichern"/>
            <Button Grid.Column="6" Classes="klein" Content="G-code ausführen"/>
          </Grid>

          <!-- Referenzbild + Ausgangsposition + Starten-von -->
          <Grid Grid.Row="7" ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
              <Button Classes="klein" Content="Referenzbild"/>
              <Button Classes="klein" Content="Zur Ausgangsposition gehen"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Starten von:" FontSize="11" Foreground="#B8B8B8" VerticalAlignment="Center"/>
              <ComboBox Width="130" Height="24" FontSize="11" SelectedIndex="0">
                <ComboBoxItem Content="Aktuelle Position"/>
                <ComboBoxItem Content="Job-Ausgangsposition"/>
              </ComboBox>
            </StackPanel>
          </Grid>

          <!-- Checkboxen links + Job-Ausgangsposition/9-Grid rechts -->
          <Grid Grid.Row="8" ColumnDefinitions="*,Auto" Margin="0,5,0,0">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Top">
              <CheckBox Content="Nur ausgewählte Grafiken senden" FontSize="11" Foreground="#D8D8D8"/>
              <CheckBox Content="Ausgangsposition der Auswahl verwenden" FontSize="11" Foreground="#D8D8D8"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Width="212" Orientation="Vertical">
              <TextBlock Text="Job-Ausgangsposition" FontSize="11" Foreground="#D8D8D8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              <local:PunkteRaster9 Width="60" Height="42" HorizontalAlignment="Center" Margin="0,3,0,4"/>
              <StackPanel Spacing="3">
                <Button Classes="klein" Content="Letzte Position anzeigen" HorizontalAlignment="Stretch"/>
                <Button Classes="klein" Content="Optimierungseinstellungen" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Geräte-Zeile -->
          <StackPanel Grid.Row="9" Orientation="Horizontal" Spacing="6" Margin="0,7,0,2">
            <TextBlock Text="Gerät:" FontSize="11" Foreground="#B8B8B8" VerticalAlignment="Center"/>
            <ComboBox Width="180" Height="24" FontSize="11" SelectedIndex="0">
              <ComboBoxItem Content="COM3"/>
            </ComboBox>
            <ComboBox Width="150" Height="24" FontSize="11" SelectedIndex="0">
              <ComboBoxItem Content="GRBL"/>
            </ComboBox>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>